// Test Suite for Urmom Lang
fn test_arithmetic() {
    assert 1 + 1 == 2, "Addition"
    assert 10 - 3 == 7, "Subtraction"
    assert 4 * 5 == 20, "Multiplication"
    assert 10 / 2 == 5, "Division"
    assert 10 % 3 == 1, "Modulo"
    assert 2 ** 3 == 8, "Power"
}

fn test_strings() {
    let s = "hello"
    assert len(s) == 5, "String length"
    assert upper(s) == "HELLO", "Upper"
    assert lower("HELLO") == "hello", "Lower"
    assert s + " world" == "hello world", "Concatenation"
}

fn test_arrays() {
    let arr = [1, 2, 3]
    assert len(arr) == 3, "Array length"
    assert arr[0] == 1, "Array index"
    assert sum(arr) == 6, "Array sum"
    let sorted = sort([3, 1, 2])
    assert sorted[0] == 1, "Array sort"
}

fn test_dicts() {
    let d = {"a": 1, "b": 2}
    assert d["a"] == 1, "Dict access"
    assert len(d) == 2, "Dict length"
}

fn test_control_flow() {
    let mut x = 0
    for i in range(5) {
        x = x + 1
    }
    assert x == 5, "For loop"
    
    let mut y = 0
    let mut i = 0
    while i < 3 {
        y = y + 10
        i = i + 1
    }
    assert y == 30, "While loop"
}

fn test_functions() {
    let add = fn(a, b) => a + b
    assert add(2, 3) == 5, "Lambda"
    
    let double = fn(x) => x * 2
    assert double(7) == 14, "Named function"
}

fn test_error_handling() {
    let mut caught = false
    try {
        throw error("TestError", "test message")
    } catch {
        caught = true
    }
    assert caught, "Try/catch"
}

fn test_type_conversions() {
    assert str(42) == "42", "int to str"
    assert int("42") == 42, "str to int"
}

fn test_concurrency() {
    let task = spawn fn() => 99
    let val = task.get_value()
    assert val == 99, "Spawn and get value"
}
