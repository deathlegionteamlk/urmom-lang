// Data Structures in Urmom Lang

// Arrays
let fruits = ["apple", "banana", "cherry"]
println("fruits: " + str(fruits))
println("first: " + fruits[0])
println("length: " + str(len(fruits)))

// Array methods
let nums = [3, 1, 4, 1, 5, 9, 2, 6]
println("sorted: " + str(sort(nums)))
println("reversed: " + str(reverse(nums)))
println("sum: " + str(sum(nums)))
println("min: " + str(min(nums)))
println("max: " + str(max(nums)))

// Dictionaries
let person = {
    "name": "Gopher",
    "age": 25,
    "lang": "Urmom"
}
println("person: " + str(person))
println("name: " + str(person["name"]))

// Dict methods
println("keys: " + str(person.keys()))
println("values: " + str(person.values()))

// Tuples
let coord = (10, 20)
println("coord: " + str(coord))

// Sets
let unique = {1, 2, 3, 3, 2, 1}
println("unique: " + str(unique))

// Ranges
let r = range(1, 6)
println("range: " + str(r))

// Nested structures
let matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
println("matrix: " + str(matrix))
println("matrix[1][2]: " + str(matrix[1][2]))

// String operations
let greeting = "Hello, Urmom Lang!"
println("upper: " + upper(greeting))
println("lower: " + lower(greeting))
println("length: " + str(len(greeting)))
println("split: " + str(split(greeting, " ")))
println("contains: " + str(contains(greeting, "Urmom")))

// JSON
let data = json_stringify({"key": "value", "num": 42})
println("JSON: " + data)
let parsed = json_parse(data)
println("parsed: " + str(parsed))
