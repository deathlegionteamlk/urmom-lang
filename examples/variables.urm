// Variables in Urmom Lang - Immutable by default
let x = 10
let mut y = 20
let name = "Urmom Lang"
let pi = 3.14159
let is_cool = true
let nothing = none

println("x = " + str(x))
println("y = " + str(y))
println("name = " + name)
println("pi = " + str(pi))
println("is_cool = " + str(is_cool))
println("nothing = " + str(nothing))

// Reassignment only with mut
y = 42
println("y is now: " + str(y))

// Constants
const VERSION = "0.2.0"
println("Version: " + VERSION)
