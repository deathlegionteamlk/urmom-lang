// Standard Library Showcase
// Urmom Lang comes with a comprehensive standard library

// ===== String Operations =====
let text = "Hello, World!"
println("upper: " + text.upper())
println("lower: " + text.lower())
println("trim: " + "  spaces  ".trim())
println("replace: " + text.replace("World", "Urmom"))
println("split: " + str(text.split(", ")))
println("starts_with: " + str(text.starts_with("Hello")))
println("contains: " + str(text.contains("World")))

// ===== Math Functions =====
println("sqrt(144) = " + str(sqrt(144)))
println("pow(2, 10) = " + str(pow(2, 10)))
println("abs(-42) = " + str(abs(-42)))
println("floor(3.7) = " + str(floor(3.7)))
println("ceil(3.2) = " + str(ceil(3.2)))
println("round(3.5) = " + str(round(3.5)))
println("sin(0) = " + str(sin(0)))
println("pi = " + str(pi))

// ===== Collection Operations =====
let nums = [5, 3, 8, 1, 9, 2, 7, 4, 6]
println("sort: " + str(sort(nums)))
println("reverse: " + str(reverse(nums)))
println("sum: " + str(sum(nums)))
println("unique: " + str(unique([1, 2, 2, 3, 3, 3])))
println("chunk: " + str(chunk(nums, 3)))

// ===== Time =====
println("Current time: " + time_format())
println("Unix timestamp: " + str(time_now()))

// ===== Random =====
println("Random float: " + str(random()))
println("Random int [1,100]: " + str(random_int(1, 100)))

// ===== Hashing =====
println("MD5 of 'hello': " + md5("hello"))
println("SHA256 of 'hello': " + sha256("hello"))

// ===== Encoding =====
let encoded = base64_encode("Urmom Lang")
println("Base64 encoded: " + encoded)
println("Base64 decoded: " + base64_decode(encoded))

// ===== UUID =====
println("UUID v4: " + uuid_v4())

// ===== File Operations =====
println("Current directory: " + cwd())
println("File exists test.urm: " + str(file_exists("test.urm")))

// ===== Regex =====
let pattern = regex("\\d+")
let matches = regex_find_all("\\d+", "abc123def456")
println("Regex matches: " + str(matches))

// ===== OS =====
println("Type of hello: " + type_of("hello"))
