// Functions in Urmom Lang
fn greet(name) {
    println("Hello, " + name + "!")
}

greet("World")

// Lambda expressions
let double = fn(x) => x * 2
let add = fn(a, b) => a + b

println("double(5) = " + str(double(5)))
println("add(3, 4) = " + str(add(3, 4)))

// Closures
fn make_counter(start) {
    let mut count = start
    fn() {
        count = count + 1
        count
    }
}

let counter = make_counter(0)
println("counter() = " + str(counter()))
println("counter() = " + str(counter()))
println("counter() = " + str(counter()))

// Higher-order functions
let numbers = [1, 2, 3, 4, 5]
let doubled = map(fn(x) => x * 2, numbers)
let evens = filter(fn(x) => x % 2 == 0, numbers)
let total = reduce(fn(a, b) => a + b, numbers, 0)

println("doubled: " + str(doubled))
println("evens: " + str(evens))
println("total: " + str(total))

// Recursive function
fn fibonacci(n) {
    if n <= 1 {
        return n
    }
    fibonacci(n - 1) + fibonacci(n - 2)
}

println("fib(10) = " + str(fibonacci(10)))

// Pipe operator
let result = [1, 2, 3, 4, 5] |> fn(arr) => map(fn(x) => x * x, arr)
println("piped: " + str(result))
