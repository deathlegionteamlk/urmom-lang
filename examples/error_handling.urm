// Error Handling in Urmom Lang
// try/catch/finally, throw, defensive programming

fn main() {
    println("=== Error Handling in Urmom Lang ===\n")

    // Basic try-catch
    println("--- Basic Try-Catch ---")
    try {
        let result = divide(10, 0)
        println("Result: " + to_string(result))
    } catch e {
        println("Caught error: " + to_string(e))
    }

    // Try-catch with finally
    println("\n--- Try-Catch-Finally ---")
    try {
        let result = safe_divide(10, 2)
        println("Result: " + to_string(result))
    } catch e {
        println("Error: " + to_string(e))
    } finally {
        println("Cleanup: Division operation complete")
    }

    // Multiple error scenarios
    println("\n--- Multiple Error Scenarios ---")
    let values = [10, 0, -5, 3]

    for val in values {
        try {
            let result = safe_divide(100, val)
            println("  100 / " + to_string(val) + " = " + to_string(result))
        } catch e {
            println("  100 / " + to_string(val) + " -> Error: " + to_string(e))
        }
    }

    // Assertions
    println("\n--- Assertions ---")
    try {
        assert(2 + 2 == 4, "Math should work")
        println("✓ Basic math assertion passed")
    } catch e {
        println("Assertion failed: " + to_string(e))
    }

    try {
        assert_eq("hello", "hello")
        println("✓ String equality assertion passed")
    } catch e {
        println("Assertion failed: " + to_string(e))
    }

    // Custom error types with throw
    println("\n--- Custom Errors ---")
    try {
        validate_age(-5)
    } catch e {
        println("Validation error: " + to_string(e))
    }

    try {
        validate_age(25)
        println("✓ Age 25 is valid")
    } catch e {
        println("Unexpected error: " + to_string(e))
    }

    println("\n✓ Error handling demo complete!")
}

fn divide(a, b) {
    if b == 0 {
        throw "Division by zero!"
    }
    a / b
}

fn safe_divide(a, b) {
    if b == 0 {
        throw "Cannot divide by zero"
    }
    if a < 0 || b < 0 {
        throw "Both values must be positive"
    }
    a / b
}

fn validate_age(age) {
    if age < 0 {
        throw "Age cannot be negative"
    }
    if age > 150 {
        throw "Age seems unrealistic"
    }
    assert(age >= 0 && age <= 150, "Invalid age")
}

main()
