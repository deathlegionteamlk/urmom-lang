// Error Handling in Urmom Lang

// Try/catch
try {
    let result = 10 / 0
    println("This won't print")
} catch {
    println("Caught division error!")
}

// Throwing errors
fn risky(x) {
    if x < 0 {
        throw error("NegativeValue", "x must be non-negative")
    }
    return x * 2
}

try {
    let val = risky(-5)
} catch as err {
    println("Error: " + str(err))
}

// Assertions
assert 1 + 1 == 2, "Math works"
assert true, "Truth is truth"

// Finally block
try {
    println("Trying something...")
} catch {
    println("Error occurred")
} finally {
    println("Cleanup done")
}

println("All error handling passed!")
