// Control Flow in Urmom Lang
// if/elif/else, for, while, match

fn main() {
    // If-elif-else
    println("=== If/Elif/Else ===")
    let score = 85

    if score >= 90 {
        println("Grade: A")
    } elif score >= 80 {
        println("Grade: B")
    } elif score >= 70 {
        println("Grade: C")
    } else {
        println("Grade: F")
    }

    // For-in loop
    println("\n=== For-In Loop ===")
    let fruits = ["apple", "banana", "cherry", "date"]
    for fruit in fruits {
        println("  Fruit: " + fruit)
    }

    // Range iteration
    println("\n=== Range Iteration ===")
    for i in range(1, 6) {
        println("  Count: " + to_string(i))
    }

    // While loop
    println("\n=== While Loop ===")
    let mut countdown = 5
    while countdown > 0 {
        println("  T-minus " + to_string(countdown))
        countdown -= 1
    }
    println("  Lift off!")

    // Match statement
    println("\n=== Match Statement ===")
    let day = "Tuesday"
    match day {
        "Monday" => {
            println("Start of the work week!")
        }
        "Friday" => {
            println("Almost weekend!")
        }
        "Saturday" => {
            println("Weekend vibes!")
        }
        "Sunday" => {
            println("Rest day!")
        }
        _ => {
            println("Just a regular " + day)
        }
    }
}

main()
