// Control Flow in Urmom Lang
let score = 85

// If/elif/else
if score >= 90 {
    println("Grade: A")
} elif score >= 80 {
    println("Grade: B")
} elif score >= 70 {
    println("Grade: C")
} else {
    println("Grade: F")
}

// While loop
let mut i = 0
while i < 5 {
    println("while: " + str(i))
    i = i + 1
}

// For-in loop
for item in [10, 20, 30, 40, 50] {
    println("for: " + str(item))
}

// Range iteration
for n in range(5) {
    println("range: " + str(n))
}

// Infinite loop with break
let mut count = 0
loop {
    count = count + 1
    if count >= 3 {
        break
    }
}
println("Loop count: " + str(count))

// Match statement
let value = 42
match value {
    0 => println("zero")
    1 => println("one")
    42 => println("the answer!")
    _ => println("something else: " + str(value))
}
