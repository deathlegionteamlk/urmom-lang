// Concurrency in Urmom Lang
// Spawn tasks, communicate via channels, synchronize with futures

// Spawn a concurrent task
let task = spawn fn() {
    42
}
println("Task spawned! Waiting for result...")
let result = task.get_value()
println("Task result: " + str(result))

// Create a channel
let ch = chan(10)

// Spawn producer
spawn fn() {
    for i in range(5) {
        ch.send(i)
        println("Sent: " + str(i))
    }
    ch.close()
}

// Collect from channel
sleep(0.5)
let mut received = []
for i in range(5) {
    let val = ch.receive()
    push(received, val)
}
println("Received: " + str(received))

// Parallel processing with closures
let mut futures = []
for n in [1, 2, 3, 4, 5] {
    let num = n
    let f = spawn fn() {
        num * num
    }
    push(futures, f)
}

let mut results = []
for f in futures {
    push(results, f.get_value())
}
println("Parallel squares: " + str(results))
